VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# UniSMS credentials are server-only Supabase Edge Function secrets. Never
# prefix these with VITE_ and never place live values in this repository.
# Configure with: npx supabase secrets set --project-ref <project-ref> ...
UNISMS_API_SECRET=server_only_secret
UNISMS_SENDER_ID=approved_sender_id
OTP_HASH_SECRET=long_random_server_only_secret
