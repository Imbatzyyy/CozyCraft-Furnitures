{
  "name": "cozycraft-furnitures",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser-readiness.mjs",
    "test:journeys": "vitest run src/features/storefront/catalog/content-loading.test.tsx src/features/storefront/authentication/auth-journeys.test.tsx src/features/storefront/account/AccountPreferences.test.tsx src/components/DialogAccessibility.test.tsx src/features/admin/content/ContentManagement.test.tsx src/lib/admin/draft-collection.test.tsx src/lib/auth/pending-email.test.tsx",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:db": "node scripts/test-readiness-db.mjs && node scripts/test-classroom-forecast-db.mjs && node scripts/test-payment-limits-db.mjs && node scripts/test-commerce-reports-db.mjs && node scripts/test-catalog-visits-db.mjs && node scripts/test-free-plan-db.mjs && node scripts/test-backup-local.mjs",
    "test:edge": "npx --yes deno@2.9.6 test --config supabase/functions/deno.json --frozen --node-modules-dir=none --allow-env --allow-read supabase/functions/",
    "verify:release": "npm run verify && npm run test:db && npm run test:edge && node scripts/check-migration-manifest.mjs && npm run audit:prod",
    "release:database": "node scripts/release-readiness.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "heic-to": "1.6.7",
    "jspdf": "^4.2.1",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "2.15.2",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  }
}
