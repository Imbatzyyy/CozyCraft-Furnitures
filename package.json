{
  "name": "cozycraft-furnitures",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:journeys": "vitest run src/features/storefront/catalog/content-loading.test.tsx src/features/storefront/authentication/auth-journeys.test.tsx src/features/storefront/account/AccountPreferences.test.tsx src/components/DialogAccessibility.test.tsx src/features/admin/content/ContentManagement.test.tsx src/lib/admin/draft-collection.test.tsx src/lib/auth/pending-email.test.tsx",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:db": "node scripts/test-readiness-db.mjs",
    "test:edge": "npx --yes deno@2.9.6 test --no-config --no-lock --node-modules-dir=none --allow-env --allow-read supabase/functions/",
    "verify:release": "npm run verify && npm run test:db && npm run test:edge && node scripts/check-migration-manifest.mjs && npm run audit:prod",
    "release:database": "node scripts/release-readiness.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.111.0",
    "heic-to": "1.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "recharts": "2.15.2",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
